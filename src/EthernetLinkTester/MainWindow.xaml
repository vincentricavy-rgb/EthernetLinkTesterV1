<Window x:Class="EthernetLinkTester.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Ethernet Link Tester Pro" Height="900" Width="1450" MinWidth="1180" MinHeight="760" WindowStartupLocation="CenterScreen">
<Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="#0D1A2C" CornerRadius="18" Padding="17"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="ETHERNET" Foreground="{StaticResource Accent}" FontSize="22" FontWeight="Bold"/><TextBlock Text="LINK TESTER PRO" FontSize="18" FontWeight="SemiBold" Margin="0,-2,0,20"/><TextBlock Text="QUALIFICATION" Foreground="{StaticResource Muted}"/><TextBlock Text="IP · L2 · VLAN · RFC 2544" Margin="0,4"/><TextBlock Text="ITU-T Y.1564 EtherSAM"/><Separator Margin="0,18" Background="#29405F"/><TextBlock Text="Rôle" Foreground="{StaticResource Muted}"/><Button x:Name="EmitterButton" Content="ÉMETTEUR / PILOTE" Style="{StaticResource PrimaryButton}" Click="Emitter_Click"/><Button x:Name="ReceiverButton" Content="RÉCEPTEUR / REFLECTOR" Click="Receiver_Click"/><TextBlock Text="État" Foreground="{StaticResource Muted}" Margin="0,16,0,4"/><TextBlock x:Name="RoleState" Text="● PRÊT" Foreground="{StaticResource Success}" FontWeight="Bold" TextWrapping="Wrap"/></StackPanel><StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom"><TextBlock Text="Version 1.0 Full Source" Foreground="{StaticResource Muted}"/><TextBlock Text="Windows 11 x64 · .NET 8" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></DockPanel></Border>
<Grid Grid.Column="1" Margin="14,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="185"/></Grid.RowDefinitions>
<Grid Margin="4,0,4,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Ethernet Link Tester" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Diagnostic · VLAN · QoS · RFC 2544 · Y.1564" Foreground="{StaticResource Muted}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="IP distante" Foreground="{StaticResource Muted}"/><TextBox x:Name="RemoteIp" Text="192.168.1.20"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Port" Foreground="{StaticResource Muted}"/><TextBox x:Name="PortBox" Text="5201"/></StackPanel></Grid>
<TabControl Grid.Row="1" x:Name="Tabs">
<TabItem Header="Dashboard"><ScrollViewer><StackPanel>
<UniformGrid Columns="4"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="LATENCE" Foreground="{StaticResource Muted}"/><TextBlock x:Name="LatencyText" Text="— ms" FontSize="28" FontWeight="Bold"/><TextBlock x:Name="LatencySub" Text="min / avg / max" Foreground="{StaticResource Success}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="GIGUE" Foreground="{StaticResource Muted}"/><TextBlock x:Name="JitterText" Text="— ms" FontSize="28" FontWeight="Bold"/><TextBlock Text="variation RTT" Foreground="{StaticResource Success}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="PERTES" Foreground="{StaticResource Muted}"/><TextBlock x:Name="LossText" Text="— %" FontSize="28" FontWeight="Bold"/><TextBlock Text="paquets" Foreground="{StaticResource Success}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="DÉBIT TCP" Foreground="{StaticResource Muted}"/><TextBlock x:Name="TcpText" Text="— Mbps" FontSize="28" FontWeight="Bold"/><TextBlock Text="sens émission" Foreground="{StaticResource Accent}"/></StackPanel></Border></UniformGrid>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Tests rapides" FontSize="19" FontWeight="SemiBold"/><WrapPanel Margin="0,8"><Button Content="▶ Latence / gigue / pertes" Style="{StaticResource PrimaryButton}" Click="QuickPing_Click"/><Button Content="▶ Débit TCP 10 s" Click="QuickTcp_Click"/><Button Content="▶ Débit UDP 10 s" Click="QuickUdp_Click"/><Button Content="▶ MTU" Click="Mtu_Click"/><Button Content="▶ Tout lancer" Style="{StaticResource PrimaryButton}" Click="AllQuick_Click"/></WrapPanel><TextBlock x:Name="MtuText" Text="MTU : —" Foreground="{StaticResource Muted}" FontSize="16"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="État des modules" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="● TCP / UDP / ICMP" Foreground="{StaticResource Success}" Margin="0,8,0,2"/><TextBlock Text="● MTU / Ports" Foreground="{StaticResource Success}"/><TextBlock Text="● VLAN 802.1Q / PCP / QinQ via Npcap" Foreground="{StaticResource Success}"/><TextBlock Text="● RFC 2544 logiciel" Foreground="{StaticResource Success}"/><TextBlock Text="● Y.1564 EtherSAM logiciel" Foreground="{StaticResource Success}"/><TextBlock Text="Mesures logicielles : validation métrologique requise pour certification." Foreground="{StaticResource Warning}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border></Grid>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header="Ports / MTU"><Grid Margin="5"><Grid.ColumnDefinitions><ColumnDefinition Width="380"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Scan TCP" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Ports (séparés par virgules)" Foreground="{StaticResource Muted}"/><TextBox x:Name="PortsBox" Text="22,53,80,443,5201"/><Button Content="Lancer le scan" Style="{StaticResource PrimaryButton}" Click="Ports_Click"/><Separator Margin="0,16"/><TextBlock Text="MTU / Jumbo frames" FontSize="20"/><TextBlock Text="Recherche avec DF (IPv4/ICMP)." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/><Button Content="Détecter MTU" Click="Mtu_Click"/></StackPanel></Border><DataGrid Grid.Column="1" x:Name="PortsGrid" IsReadOnly="True" AutoGenerateColumns="True" Margin="5"/></Grid></TabItem>
<TabItem Header="Ethernet L2 / VLAN"><Grid Margin="5"><Grid.ColumnDefinitions><ColumnDefinition Width="410"/><ColumnDefinition/></Grid.ColumnDefinitions><ScrollViewer><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="802.1Q / VLAN" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Interface Npcap" Foreground="{StaticResource Muted}"/><ComboBox x:Name="AdapterBox"/><Button Content="Actualiser interfaces" Click="RefreshAdapters_Click"/><TextBlock Text="MAC source" Foreground="{StaticResource Muted}"/><TextBox x:Name="SrcMac" Text="00:11:22:33:44:55"/><TextBlock Text="MAC distante" Foreground="{StaticResource Muted}"/><TextBox x:Name="DstMac" Text="00:11:22:33:44:66"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="VLAN ID" Foreground="{StaticResource Muted}"/><TextBox x:Name="VlanId" Text="100"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="PCP 0-7" Foreground="{StaticResource Muted}"/><TextBox x:Name="PcpBox" Text="0"/></StackPanel></Grid><Button Content="Tester ce VLAN" Style="{StaticResource PrimaryButton}" Click="VlanOne_Click"/><TextBlock Text="QinQ / 802.1ad" FontSize="18" Margin="0,8,0,0"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="S-VLAN externe" Foreground="{StaticResource Muted}"/><TextBox x:Name="OuterVlan" Text="10"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="C-VLAN interne" Foreground="{StaticResource Muted}"/><TextBox x:Name="InnerVlan" Text="100"/></StackPanel></Grid><Button Content="Tester QinQ" Click="QinQ_Click"/><Separator Margin="0,13"/><TextBlock Text="Scan VLAN" FontSize="18"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="VlanFrom" Text="1"/><TextBox Grid.Column="1" x:Name="VlanTo" Text="100"/></Grid><Button Content="Scanner la plage" Click="VlanScan_Click"/><ProgressBar x:Name="VlanProgress" Height="8" Minimum="0" Maximum="100" Margin="0,8"/><TextBlock Text="Le récepteur doit activer le reflector L2 sur la même liaison." Foreground="{StaticResource Warning}" TextWrapping="Wrap"/></StackPanel></Border></ScrollViewer><DataGrid Grid.Column="1" x:Name="VlanGrid" IsReadOnly="True" AutoGenerateColumns="True" Margin="5"/></Grid></TabItem>
<TabItem Header="RFC 2544"><Grid Margin="5"><Grid.ColumnDefinitions><ColumnDefinition Width="370"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="RFC 2544" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Throughput · Latency · Frame loss · Back-to-back" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/><TextBlock Text="Débit de ligne (Mbit/s)" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/><TextBox x:Name="RfcRate" Text="1000"/><TextBlock Text="Tailles de trames" Foreground="{StaticResource Muted}"/><TextBox x:Name="RfcSizes" Text="64,128,256,512,1024,1280,1518"/><Button Content="▶ Lancer campagne RFC 2544" Style="{StaticResource PrimaryButton}" Click="Rfc_Click"/><Button Content="Exporter CSV" Click="ExportRfc_Click"/><TextBlock Text="Implémentation logicielle de qualification. Le PC/NIC/OS peut limiter la précision à très haut débit." Foreground="{StaticResource Warning}" TextWrapping="Wrap" Margin="0,12"/></StackPanel></Border><DataGrid Grid.Column="1" x:Name="RfcGrid" IsReadOnly="True" AutoGenerateColumns="True" Margin="5"/></Grid></TabItem>
<TabItem Header="Y.1564 EtherSAM"><Grid Margin="5"><Grid.ColumnDefinitions><ColumnDefinition Width="430"/><ColumnDefinition/></Grid.ColumnDefinitions><ScrollViewer><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ITU-T Y.1564 EtherSAM" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Profil de service" Foreground="{StaticResource Muted}"/><TextBox x:Name="YName" Text="DATA"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="VLAN" Foreground="{StaticResource Muted}"/><TextBox x:Name="YVlan" Text="100"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="PCP" Foreground="{StaticResource Muted}"/><TextBox x:Name="YPcp" Text="0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="CIR Mbps" Foreground="{StaticResource Muted}"/><TextBox x:Name="YCir" Text="100"/></StackPanel></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="EIR Mbps" Foreground="{StaticResource Muted}"/><TextBox x:Name="YEir" Text="0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="FTD max ms" Foreground="{StaticResource Muted}"/><TextBox x:Name="YFtd" Text="20"/></StackPanel></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="FDV max ms" Foreground="{StaticResource Muted}"/><TextBox x:Name="YFdv" Text="5"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="FLR max %" Foreground="{StaticResource Muted}"/><TextBox x:Name="YFlr" Text="0.1"/></StackPanel></Grid><Button Content="Ajouter service" Click="AddService_Click"/><Button Content="▶ Service Configuration Test" Style="{StaticResource PrimaryButton}" Click="YConfig_Click"/><StackPanel Orientation="Horizontal"><TextBlock Text="Durée performance (s)" VerticalAlignment="Center"/><TextBox x:Name="YDuration" Text="60" Width="85"/></StackPanel><Button Content="▶ Service Performance Test" Style="{StaticResource PrimaryButton}" Click="YPerf_Click"/><Button Content="Exporter CSV" Click="ExportY_Click"/></StackPanel></Border></ScrollViewer><Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="170"/><RowDefinition/></Grid.RowDefinitions><DataGrid x:Name="YServicesGrid" IsReadOnly="True" AutoGenerateColumns="True" Margin="5"/><DataGrid Grid.Row="1" x:Name="YResultGrid" IsReadOnly="True" AutoGenerateColumns="True" Margin="5"/></Grid></Grid></TabItem>
<TabItem Header="Historique"><Grid Margin="5"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid x:Name="HistoryGrid" IsReadOnly="True" AutoGenerateColumns="True"/><Button Grid.Row="1" Content="Exporter historique JSON" HorizontalAlignment="Left" Click="ExportHistory_Click"/></Grid></TabItem>
</TabControl>
<Border Grid.Row="2" Style="{StaticResource Card}" Margin="5"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Journal d'exécution" FontSize="17" FontWeight="SemiBold"/><TextBox x:Name="LogBox" IsReadOnly="True" Height="125" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="Effacer" VerticalAlignment="Top" Click="ClearLog_Click"/></Grid></Border>
</Grid></Grid></Window>
